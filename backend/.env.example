# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gippo_db?schema=public"

# Application Environment & Port
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-access-key-gippo-2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-gippo-2026"
JWT_REFRESH_EXPIRATION="7d"

# Admin Security Secret (Required to bootstrap/register Admin users)
ADMIN_REGISTRATION_SECRET="gippo-admin-secure-registration-code-2026"

# Payment Secrets & Webhook Verification
PAYMENT_SECRET="gippo-payment-secret-key"
PAYMENT_WEBHOOK_SECRET="gippo-webhook-signature-secret"

# AI Medical Assistant Configuration (Groq / Gemini Multi-Provider)
AI_PROVIDER="GROQ"
AI_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Video Consultation Secret
VIDEO_API_SECRET="gippo-video-telehealth-secret"

