{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/server/nest/main.ts",
    "src/server/nest/app.module.ts",
    "src/server/nest/**/*.controller.ts",
    "src/server/nest/**/*.module.ts",
    "src/server/nest/**/*.spec.ts",
    "src/server/nest/common/guards/**",
    "src/server/nest/common/decorators/**",
    "src/server/nest/common/filters/**",
    "src/server/nest/common/interceptors/**"
    ,"src/server/nest/modules/auth/strategies/**"
    ,"prisma/seed.ts"
  ]
}
